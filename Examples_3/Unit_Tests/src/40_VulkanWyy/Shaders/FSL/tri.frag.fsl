#include "Resources.h.fsl"

//RES(CBUFFER(UniformData), uniformBlock, UPDATE_FREQ_PER_DRAW, b0, binding = 0);
//RES(Tex2D(float4), RightText, UPDATE_FREQ_NONE, t1, binding = 1);
//RES(SamplerState, uSampler0, UPDATE_FREQ_NONE, s0, binding = 2);

STRUCT(VSOutput) {
	DATA(float4, Position, SV_Position);
    DATA(float3, Normal, NORMAL);
	DATA(float2, TexCoord, TEXCOORD0);        
};

ROOT_SIGNATURE(DefaultRootSignature)

float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float4 Out;

    float2 newtextcoord=In.TexCoord;
    //Œ∆¿Ì—’…´
    float4 texColor = SampleTex2D(gRightTexture, gSampler, newtextcoord);
    //float4 texColor = float4(1.0,0.0, 0.0, 1.0);
    float3 blendedColor = (gUniformBlock.lightColor.rgb * texColor.rgb) * gUniformBlock.lightIntensity;

    float3 diffuse = blendedColor * max(dot(In.Normal.xyz, gUniformBlock.lightDir), 0.0);
    float3 ambient = texColor.rgb * gUniformBlock.lightAmbient;
    Out = float4(diffuse + ambient, 1.0);
    //Out = float4(1.0,0.0, 0.0, 1.0);
    RETURN(Out);
}